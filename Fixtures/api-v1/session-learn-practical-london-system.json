98c4af4","d5573994","fb21899e","826a3ef9","a4502e45","bbeaf3c0","f25e6b3a","74f662ed","81ea90c4","4240fa3d","f8df1ed1","ac32c64e","73e67c5d","563b35c5","105c439a","f94c62ce","83ae4607","4324f295","4ff3eb5f","220d5fab","914f2e00","cd70d4de","fb4847d3","1f419d3b"]},"lines":[{"id":"0.0","chapter":0,"index":0,"startFen":"rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1","steps":[{"san":"d4","uci":"d2d4","fenBefore":"rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1","fenAfter":"rnbqkbnr/pppppppp/8/8/3P4/8/PPP1PPPP/RNBQKBNR b KQkq - 0 1","key":"rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq -|d2d4","mine":true,"comments":["The d-pawn takes central space and clears the c1 bishop's diagonal. This pawn gives the London its foundation: the pieces can develop behind it while we decide whether the game calls for a central break or play on either wing."],"shapes":[],"ply":1},{"san":"d5","uci":"d7d5","fenBefore":"rnbqkbnr/pppppppp/8/8/3P4/8/PPP1PPPP/RNBQKBNR b KQkq - 0 1","fenAfter":"rnbqkbnr/ppp1pppp/8/3p4/3P4/8/PPP1PPPP/RNBQKBNR w KQkq - 0 2","key":"rnbqkbnr/pppppppp/8/8/3P4/8/PPP1PPPP/RNBQKBNR b KQkq -|d7d5","mine":false,"comments":["Black establishes a matching central foothold. With both d-pawns fixed for now, this chapter examines an early bishop exchange on f4 and the different structures that can follow it."],"shapes":[],"ply":2},{"san":"Nf3","uci":"g1f3","fenBefore":"rnbqkbnr/ppp1pppp/8/3p4/3P4/8/PPP1PPPP/RNBQKBNR w KQkq - 0 2","fenAfter":"rnbqkbnr/ppp1pppp/8/3p4/3P4/5N2/PPP1PPPP/RNBQKB1R b KQkq - 1 2","key":"rnbqkbnr/ppp1pppp/8/3p4/3P4/8/PPP1PPPP/RNBQKBNR w KQkq -|g1f3","mine":true,"comments":["Our knight supports d4 and watches e5 before the bishop leaves home. Keeping these central squares under control makes the next few developing moves easier to coordinate, especially when Black challenges our bishop from d6."],"shapes":[],"ply":3},{"san":"Nf6","uci":"g8f6","fenBefore":"rnbqkbnr/ppp1pppp/8/3p4/3P4/5N2/PPP1PPPP/RNBQKB1R b KQkq - 1 2","fenAfter":"rnbqkb1r/ppp1pppp/5n2/3p4/3P4/5N2/PPP1PPPP/RNBQKB1R w KQkq - 2 3","key":"rnbqkbnr/ppp1pppp/8/3p4/3P4/5N2/PPP1PPPP/RNBQKB1R b KQkq -|g8f6","mine":false,"comments":["Black reinforces d5 and adds pressure to e4. The knight also brings castling closer, but its placement gives our later kingside pawn advances a concrete piece to gain time against."],"shapes":[],"ply":4},{"san":"Bf4","uci":"c1f4","fenBefore":"rnbqkb1r/ppp1pppp/5n2/3p4/3P4/5N2/PPP1PPPP/RNBQKB1R w KQkq - 2 3","fenAfter":"rnbqkb1r/ppp1pppp/5n2/3p4/3P1B2/5N2/PPP1PPPP/RN1QKB1R b KQkq - 3 3","key":"rnbqkb1r/ppp1pppp/5n2/3p4/3P4/5N2/PPP1PPPP/RNBQKB1R w KQkq -|c1f4","mine":true,"comments":["The bishop belongs beyond the coming pawn chain while e3 is still vacant. From f4 it influences e5 and looks along the diagonal toward b8; we will accept an exchange when the resulting pawns support our central plans."],"shapes":[],"ply":5},{"san":"e6","uci":"e7e6","fenBefore":"rnbqkb1r/ppp1pppp/5n2/3p4/3P1B2/5N2/PPP1PPPP/RN1QKB1R b KQkq - 3 3","fenAfter":"rnbqkb1r/ppp2ppp/4pn2/3p4/3P1B2/5N2/PPP1PPPP/RN1QKB1R w KQkq - 0 4","key":"rnbqkb1r/ppp1pppp/5n2/3p4/3P1B2/5N2/PPP1PPPP/RN1QKB1R b KQkq -|e7e6","mine":false,"comments":["Black supports d5 and opens the f8 bishop's route to d6. That prepares a direct challenge to our active bishop, while the c8 bishop will need a separate development plan."],"shapes":[],"ply":6},{"san":"e3","uci":"e2e3","fenBefore":"rnbqkb1r/ppp2ppp/4pn2/3p4/3P1B2/5N2/PPP1PPPP/RN1QKB1R w KQkq - 0 4","fenAfter":"rnbqkb1r/ppp2ppp/4pn2/3p4/3P1B2/4PN2/PPP2PPP/RN1QKB1R b KQkq - 0 4","key":"rnbqkb1r/ppp2ppp/4pn2/3p4/3P1B2/5N2/PPP1PPPP/RN1QKB1R w KQkq -|e2e3","mine":true,"comments":["We secure d4 with a second pawn and release the bishop on f1. Our dark-squared bishop has already escaped the chain, so this compact centre does not restrict it; the next decision is how to answer Black's bishop challenge."],"shapes":[],"ply":7},{"san":"Bd6","uci":"f8d6","fenBefore":"rnbqkb1r/ppp2ppp/4pn2/3p4/3P1B2/4PN2/PPP2PPP/RN1QKB1R b KQkq - 0 4","fenAfter":"rnbqk2r/ppp2ppp/3bpn2/3p4/3P1B2/4PN2/PPP2PPP/RN1QKB1R w KQkq - 1 5","key":"rnbqkb1r/ppp2ppp/4pn2/3p4/3P1B2/4PN2/PPP2PPP/RN1QKB1R b KQkq -|f8d6","mine":false,"comments":["Black offers to exchange the active London bishop. We can allow the trade and use a pawn on f4 to control e5, or exchange on d6 if Black chooses a different central setup."],"shapes":[],"ply":8},{"san":"Nbd2","uci":"b1d2","fenBefore":"rnbqk2r/ppp2ppp/3bpn2/3p4/3P1B2/4PN2/PPP2PPP/RN1QKB1R w KQkq - 1 5","fenAfter":"rnbqk2r/ppp2ppp/3bpn2/3p4/3P1B2/4PN2/PPPN1PPP/R2QKB1R b KQkq - 2 5","key":"rnbqk2r/ppp2ppp/3bpn2/3p4/3P1B2/4PN2/PPP2PPP/RN1QKB1R w KQkq -|b1d2","mine":true,"comments":["A second knight joins the struggle for e4 while the bishop exchange remains available. The knight also supports the f3 knight, keeping useful central squares available after an e-pawn recapture."],"shapes":[],"ply":9},{"san":"Bxf4","uci":"d6f4","fenBefore":"rnbqk2r/ppp2ppp/3bpn2/3p4/3P1B2/4PN2/PPPN1PPP/R2QKB1R b KQkq - 2 5","fenAfter":"rnbqk2r/ppp2ppp/4pn2/3p4/3P1b2/4PN2/PPPN1PPP/R2QKB1R w KQkq - 0 6","key":"rnbqk2r/ppp2ppp/3bpn2/3p4/3P1B2/4PN2/PPPN1PPP/R2QKB1R b KQkq -|d6f4","mine":false,"comments":["Black removes our developed bishop and changes the pawn structure. The exchange gives us doubled f-pawns after the recapture, but also opens the e-file and strengthens our grip on e5."],"shapes":[],"ply":10},{"san":"exf4","uci":"e3f4","fenBefore":"rnbqk2r/ppp2ppp/4pn2/3p4/3P1b2/4PN2/PPPN1PPP/R2QKB1R w KQkq - 0 6","fenAfter":"rnbqk2r/ppp2ppp/4pn2/3p4/3P1P2/5N2/PPPN1PPP/R2QKB1R b KQkq - 0 6","key":"rnbqk2r/ppp2ppp/4pn2/3p4/3P1b2/4PN2/PPPN1PPP/R2QKB1R w KQkq -|e3f4","mine":true,"comments":["We recapture toward the kingside, placing a pawn on f4 that controls e5. The doubled pawns are part of the plan: our remaining bishop has room on the light squares, and a rook can later use the half-open e-file."],"shapes":[],"ply":11},{"san":"O-O","uci":"e8h8","fenBefore":"rnbqk2r/ppp2ppp/4pn2/3p4/3P1P2/5N2/PPPN1PPP/R2QKB1R b KQkq - 0 6","fenAfter":"rnbq1rk1/ppp2ppp/4pn2/3p4/3P1P2/5N2/PPPN1PPP/R2QKB1R w KQ - 1 7","key":"rnbqk2r/ppp2ppp/4pn2/3p4/3P1P2/5N2/PPPN1PPP/R2QKB1R b KQkq -|e8h8","mine":false,"comments":["Black secures the king before choosing a pawn break. We can reinforce d4 with c3, then adapt our plans to a challenge from ...c5 or a queenside fianchetto with ...b6."],"shapes":[],"ply":12},{"san":"c3","uci":"c2c3","fenBefore":"rnbq1rk1/ppp2ppp/4pn2/3p4/3P1P2/5N2/PPPN1PPP/R2QKB1R w KQ - 1 7","fenAfter":"rnbq1rk1/ppp2ppp/4pn2/3p4/3P1P2/2P2N2/PP1N1PPP/R2QKB1R b KQ - 0 7","key":"rnbq1rk1/ppp2ppp/4pn2/3p4/3P1P2/5N2/PPPN1PPP/R2QKB1R w KQ -|c2c3","mine":true,"comments":["We give d4 reliable pawn support and leave c2 available as a bishop retreat. This modest move also lets us watch Black's next commitment before deciding whether to castle quietly or advance the h-pawn against the kingside."],"shapes":[],"ply":13},{"san":"c5","uci":"c7c5","fenBefore":"rnbq1rk1/ppp2ppp/4pn2/3p4/3P1P2/2P2N2/PP1N1PPP/R2QKB1R b KQ - 0 7","fenAfter":"rnbq1rk1/pp3ppp/4pn2/2pp4/3P1P2/2P2N2/PP1N1PPP/R2QKB1R w KQ - 0 8","key":"rnbq1rk1/ppp2ppp/4pn2/3p4/3P1P2/2P2N2/PP1N1PPP/R2QKB1R b KQ -|c7c5","mine":false,"comments":["Black challenges the base of our centre before we finish development. Exchanging on c5 changes the position from a fixed d-pawn structure into one where piece placement and the open central files matter more."],"shapes":[],"ply":14},{"san":"dxc5","uci":"d4c5","fenBefore":"rnbq1rk1/pp3ppp/4pn2/2pp4/3P1P2/2P2N2/PP1N1PPP/R2QKB1R w KQ - 0 8","fenAfter":"rnbq1rk1/pp3ppp/4pn2/2Pp4/5P2/2P2N2/PP1N1PPP/R2QKB1R b KQ - 0 8","key":"rnbq1rk1/pp3ppp/4pn2/2pp4/3P1P2/2P2N2/PP1N1PPP/R2QKB1R w KQ -|d4c5","mine":true,"comments":["We release the central tension and make Black spend time recovering the pawn. Our d-file is now clear of white pawns, so development toward the central files becomes especially useful once the queen and bishops find their squares."],"shapes":[],"ply":15},{"san":"Qc7","uci":"d8c7","fenBefore":"rnbq1rk1/pp3ppp/4pn2/2Pp4/5P2/2P2N2/PP1N1PPP/R2QKB1R b KQ - 0 8","fenAfter":"rnb2rk1/ppq2ppp/4pn2/2Pp4/5P2/2P2N2/PP1N1PPP/R2QKB1R w KQ - 1 9","key":"rnbq1rk1/pp3ppp/4pn2/2Pp4/5P2/2P2N2/PP1N1PPP/R2QKB1R b KQ -|d8c7","mine":false,"comments":["From c7, the queen attacks c5 vertically and f4 diagonally. We cannot preserve everything with a routine developing move; securing f4 lets Black recover c5 without damaging our intended structure."],"shapes":[],"ply":16},{"san":"g3","uci":"g2g3","fenBefore":"rnb2rk1/ppq2ppp/4pn2/2Pp4/5P2/2P2N2/PP1N1PPP/R2QKB1R w KQ - 1 9","fenAfter":"rnb2rk1/ppq2ppp/4pn2/2Pp4/5P2/2P2NP1/PP1N1P1P/R2QKB1R b KQ - 0 9","key":"rnb2rk1/ppq2ppp/4pn2/2Pp4/5P2/2P2N2/PP1N1PPP/R2QKB1R w KQ -|g2g3","mine":true,"comments":["The f4 pawn needs protection before Black recovers c5 with the queen. This also reserves g2 for the bishop if needed, although here we prefer the more direct diagonal from d3 toward the kingside."],"shapes":[],"ply":17},{"san":"Qxc5","uci":"c7c5","fenBefore":"rnb2rk1/ppq2ppp/4pn2/2Pp4/5P2/2P2NP1/PP1N1P1P/R2QKB1R b KQ - 0 9","fenAfter":"rnb2rk1/pp3ppp/4pn2/2qp4/5P2/2P2NP1/PP1N1P1P/R2QKB1R w KQ - 0 10","key":"rnb2rk1/ppq2ppp/4pn2/2Pp4/5P2/2P2NP1/PP1N1P1P/R2QKB1R b KQ -|c7c5","mine":false,"comments":[],"shapes":[],"ply":18},{"san":"Bd3","uci":"f1d3","fenBefore":"rnb2rk1/pp3ppp/4pn2/2qp4/5P2/2P2NP1/PP1N1P1P/R2QKB1R w KQ - 0 10","fenAfter":"rnb2rk1/pp3ppp/4pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2QK2R b KQ - 1 10","key":"rnb2rk1/pp3ppp/4pn2/2qp4/5P2/2P2NP1/PP1N1P1P/R2QKB1R w KQ -|f1d3","mine":true,"comments":["Our remaining bishop develops toward h7 and makes castling possible. Black's e6 pawn restricts the opposing bishop on c8, so keeping our own bishop active is a useful long-term aim even when there is no immediate attack."],"shapes":[],"ply":19},{"san":"Nc6","uci":"b8c6","fenBefore":"rnb2rk1/pp3ppp/4pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2QK2R b KQ - 1 10","fenAfter":"r1b2rk1/pp3ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2QK2R w KQ - 2 11","key":"rnb2rk1/pp3ppp/4pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2QK2R b KQ -|b8c6","mine":false,"comments":[],"shapes":[],"ply":20},{"san":"O-O","uci":"e1h1","fenBefore":"r1b2rk1/pp3ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2QK2R w KQ - 2 11","fenAfter":"r1b2rk1/pp3ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2Q1RK1 b - - 3 11","key":"r1b2rk1/pp3ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2QK2R w KQ -|e1h1","mine":true,"comments":["King safety comes first when central files are about to become the rooks' workplace. With the pawn exchanges complete, the e- and d-files offer useful routes into the game, and castling lets us begin that coordination without exposing our king."],"shapes":[],"ply":21},{"san":"Bd7","uci":"c8d7","fenBefore":"r1b2rk1/pp3ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2Q1RK1 b - - 3 11","fenAfter":"r4rk1/pp1b1ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2Q1RK1 w - - 4 12","key":"r1b2rk1/pp3ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2Q1RK1 b - -|c8d7","mine":false,"comments":[],"shapes":[],"ply":22},{"san":"Re1","uci":"f1e1","fenBefore":"r4rk1/pp1b1ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2Q1RK1 w - - 4 12","fenAfter":"r4rk1/pp1b1ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2QR1K1 b - - 5 12","key":"r4rk1/pp1b1ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2Q1RK1 w - -|f1e1","mine":true,"comments":["Our rook takes the file opened by the earlier e-pawn recapture. It supports future occupation of e5 and makes the queen's move to e2 more harmonious; we are improving the whole position before attempting a kingside advance."],"shapes":[],"ply":23},{"san":"Rfd8","uci":"f8d8","fenBefore":"r4rk1/pp1b1ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2QR1K1 b - - 5 12","fenAfter":"r2r2k1/pp1b1ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2QR1K1 w - - 6 13","key":"r4rk1/pp1b1ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2QR1K1 b - -|f8d8","mine":false,"comments":[],"shapes":[],"ply":24},{"san":"Qe2","uci":"d1e2","fenBefore":"r2r2k1/pp1b1ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1N1P1P/R2QR1K1 w - - 6 13","fenAfter":"r2r2k1/pp1b1ppp/2n1pn2/2qp4/5P2/2PB1NP1/PP1NQP1P/R3